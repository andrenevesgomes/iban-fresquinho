{
  "name": "iban-fresquinho",
  "version": "2.0.0",
  "description": "Gerador de IBANs portugueses válidos para testes e desenvolvimento",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "iban",
    "portugal",
    "generator",
    "testing",
    "banking"
  ],
  "author": "André Neves Gomes",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jsdom": "26.1.0",
    "postcss": "^8.5.25",
    "prettier": "^3.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.2",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.0.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@vercel/analytics": "^1.6.1",
    "lucide": "1.59.0"
  }
}
