{
  "name": "iban-fresquinho",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "description": "Gerador de IBANs portugueses válidos para testes e desenvolvimento",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx,css,html}\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "iban",
    "portugal",
    "generator",
    "testing",
    "banking"
  ],
  "author": "André Neves Gomes",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "10.4.23",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "js-yaml": "4.3.2",
    "jsdom": "26.1.0",
    "postcss": "8.5.25",
    "prettier": "3.7.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.1.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "lucide": "1.59.0"
  }
}
